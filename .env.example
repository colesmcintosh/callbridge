# Server only. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Mock HubSpot is local and makes no HubSpot requests. Use live to connect a real account.
HUBSPOT_MODE=mock
# HubSpot private app: crm.objects.contacts.read, crm.objects.contacts.write
HUBSPOT_ACCESS_TOKEN=
PORT=3000
# Optional absolute or workspace-relative path. Contains private transcripts.
DATA_DIR=./data
